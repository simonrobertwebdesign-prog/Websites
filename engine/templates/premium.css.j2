
:root{
  --ink:#0D1015; --ink2:#151A22; --ink3:#1E2531;
  --paper:#F4F2EC; --card:#FFFFFF; --line:#E2DFD6;
  --muted:#4A5160; --muted-d:#AEB6C3;
  --accent:{{ accent }}; --on-accent:{{ on_accent }};
  --r:18px; --wrap:1200px;
  --pad:clamp(18px,4vw,48px);
  --display:"Archivo","Arial Narrow",Arial,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:var(--paper);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{max-width:var(--wrap);margin:0 auto;padding:0 var(--pad)}
.eyebrow{margin:0;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
h1,h2,h3{font-family:var(--display);margin:0;letter-spacing:-.02em}
h2{font-size:clamp(34px,5.4vw,72px);line-height:.95;font-weight:900;font-stretch:112%;text-transform:uppercase}
h3{font-size:22px;font-weight:800;font-stretch:105%}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:54px;padding:0 26px;border-radius:999px;font-weight:700;font-size:16px;text-decoration:none;border:0;cursor:pointer;font-family:inherit;transition:transform .2s ease, box-shadow .2s ease, background .2s ease}
.btn:hover{transform:translateY(-2px)}
.btn-accent{background:var(--accent);color:var(--on-accent);box-shadow:0 10px 30px -10px color-mix(in srgb,var(--accent) 70%,transparent)}
.btn-accent:hover{box-shadow:0 16px 40px -10px color-mix(in srgb,var(--accent) 90%,transparent)}
.btn-ghost{background:rgba(255,255,255,.06);color:#fff;border:1px solid rgba(255,255,255,.28);backdrop-filter:blur(8px)}
.btn-dark{background:var(--ink);color:#fff}
.btn svg{flex:none}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}

/* demo banner */
.demo{background:var(--accent);color:var(--on-accent);font-size:14px;font-weight:600;text-align:center;padding:10px var(--pad);position:relative;z-index:60}
.demo a{font-weight:800}

/* nav */
.nav{position:sticky;top:0;z-index:50;transition:background .3s ease, box-shadow .3s ease;background:transparent}
.nav.solid{background:rgba(13,16,21,.86);backdrop-filter:blur(14px);box-shadow:0 1px 0 rgba(255,255,255,.08)}
.nav-in{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:76px}
.logo{display:flex;align-items:center;gap:12px;text-decoration:none;color:#fff}
.logo-mark{width:42px;height:42px;border-radius:12px;background:var(--accent);color:var(--on-accent);display:grid;place-items:center}
.logo-name{font-family:var(--display);font-weight:900;font-stretch:115%;font-size:19px;letter-spacing:-.01em;line-height:1}
.logo-name small{display:block;font-family:Inter,sans-serif;font-weight:600;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted-d);margin-top:4px;font-stretch:100%}
.links{display:flex;align-items:center;gap:6px}
.links a{color:#E6E9EF;text-decoration:none;font-weight:600;font-size:15px;padding:10px 14px;border-radius:999px;transition:background .2s}
.links a:hover{background:rgba(255,255,255,.08)}
.links .btn{min-height:46px;padding:0 20px;margin-left:8px}
.menu-btn{display:none;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);color:#fff;width:48px;height:48px;border-radius:12px;cursor:pointer}
@media (max-width:860px){
  .menu-btn{display:grid;place-items:center}
  .links{position:absolute;left:var(--pad);right:var(--pad);top:80px;flex-direction:column;align-items:stretch;background:var(--ink2);border:1px solid rgba(255,255,255,.1);border-radius:var(--r);padding:12px;display:none}
  .links.open{display:flex}
  .links a{padding:14px}
  .links .btn{margin:6px 0 0}
}

/* hero */
.hero{position:relative;margin-top:-76px;min-height:min(100vh,900px);display:flex;align-items:flex-end;color:#fff;overflow:hidden;background:var(--ink)}
.hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.06);animation:heroZoom 14s ease-out forwards}
@keyframes heroZoom{to{transform:scale(1)}}
.hero::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(13,16,21,.94) 0%,rgba(13,16,21,.78) 42%,rgba(13,16,21,.25) 100%),linear-gradient(0deg,rgba(13,16,21,1) 0%,rgba(13,16,21,0) 35%)}
.hero-glow{position:absolute;inset:0;z-index:1;pointer-events:none;background:radial-gradient(420px circle at var(--mx,70%) var(--my,40%),color-mix(in srgb,var(--accent) 16%,transparent),transparent 60%);transition:background .1s}
.hero-in{position:relative;z-index:2;padding-top:150px;padding-bottom:clamp(40px,6vw,72px);width:100%}
.hero h1{font-size:clamp(54px,10.5vw,150px);line-height:.86;font-weight:900;font-stretch:125%;text-transform:uppercase;letter-spacing:-.035em;max-width:11ch}
.spark{position:relative;display:inline-block;color:var(--accent)}
.spark::after{content:"";position:absolute;left:0;right:0;bottom:.04em;height:.07em;background:var(--accent);transform-origin:left;transform:scaleX(0);animation:draw 1s .5s cubic-bezier(.7,0,.2,1) forwards;border-radius:4px}
@keyframes draw{to{transform:scaleX(1)}}
.hero p.lead{font-size:clamp(17px,1.7vw,21px);color:#D4D9E1;max-width:36em;margin:28px 0 0}
.hero-ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.pills{display:flex;flex-wrap:wrap;gap:10px;margin-top:40px;padding:0;list-style:none}
.pills li{display:flex;align-items:center;gap:8px;padding:10px 16px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(10px);font-size:14px;font-weight:600}
.pills svg{color:var(--accent)}

/* marquee */
.marquee{background:var(--ink);color:#fff;overflow:hidden;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08);padding:22px 0}
.track{display:flex;width:max-content;animation:slide 32s linear infinite}
.track span{font-family:var(--display);font-weight:900;font-stretch:125%;text-transform:uppercase;font-size:clamp(28px,4vw,52px);letter-spacing:-.02em;display:flex;align-items:center;gap:28px;padding-right:28px;white-space:nowrap}
.track span.o{color:transparent;-webkit-text-stroke:1.5px rgba(255,255,255,.55)}
.track svg{color:var(--accent);flex:none}
@keyframes slide{to{transform:translateX(-50%)}}

/* sections */
section{padding:clamp(72px,10vw,140px) 0}
.head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:clamp(36px,5vw,64px)}
.head .eyebrow{color:var(--muted);margin-bottom:16px}
.head p{max-width:30em;color:var(--muted);margin:0;font-size:17px}

/* bento */
.bento{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:minmax(230px,auto);gap:16px}
.tile{position:relative;border-radius:var(--r);overflow:hidden;background:var(--card);border:1px solid var(--line);padding:28px;display:flex;flex-direction:column;justify-content:flex-end;gap:10px;isolation:isolate;transition:transform .35s ease, box-shadow .35s ease}
.tile:hover{transform:translateY(-4px);box-shadow:0 24px 50px -24px rgba(13,16,21,.35)}
.tile p{margin:0;color:var(--muted);font-size:15px}
.tile .ic{width:52px;height:52px;border-radius:14px;background:var(--ink);color:var(--accent);display:grid;place-items:center;margin-bottom:auto}
.tile.photo{color:#fff;border:0;min-height:300px}
.tile.photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
.tile.photo::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(0deg,rgba(13,16,21,.9) 0%,rgba(13,16,21,.2) 60%,rgba(13,16,21,0) 100%)}
.tile.photo:hover img{transform:scale(1.07)}
.tile.photo p{color:#DCE0E7}
.tile .tag{position:absolute;top:20px;left:20px;background:var(--accent);color:var(--on-accent);font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:6px 12px;border-radius:999px}
.span2{grid-column:span 2}
.row2{grid-row:span 2}
.tile.big h3{font-size:clamp(26px,3vw,38px);font-stretch:118%;text-transform:uppercase;line-height:.95}
@media (max-width:900px){.bento{grid-template-columns:repeat(2,minmax(0,1fr))}.row2{grid-row:span 1}}
@media (max-width:560px){.bento{grid-template-columns:1fr}.span2{grid-column:span 1}}

/* before after */
.dark{background:var(--ink);color:#fff}
.dark .eyebrow,.dark .head p{color:var(--muted-d)}
.ba{position:relative;width:100%;height:clamp(320px,46vw,600px);border-radius:calc(var(--r) + 6px);overflow:hidden;--pos:50%;user-select:none;background:var(--ink3)}
.ba img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.ba .before{clip-path:inset(0 calc(100% - var(--pos)) 0 0)}
.ba .bar{position:absolute;top:0;bottom:0;left:var(--pos);width:3px;background:var(--accent);transform:translateX(-50%);pointer-events:none}
.ba .knob{position:absolute;top:50%;left:var(--pos);transform:translate(-50%,-50%);width:58px;height:58px;border-radius:50%;background:var(--accent);color:var(--on-accent);display:grid;place-items:center;box-shadow:0 10px 30px rgba(0,0,0,.4);pointer-events:none}
.ba input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}
.ba .lab{position:absolute;bottom:18px;padding:8px 14px;border-radius:999px;background:rgba(13,16,21,.75);backdrop-filter:blur(8px);font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;pointer-events:none}
.ba .lab.l{left:18px}.ba .lab.r{right:18px}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:16px;margin-top:20px}
.facts div{border:1px solid rgba(255,255,255,.12);border-radius:var(--r);padding:20px 22px}
.facts span{display:block;font-size:13px;color:var(--muted-d);font-weight:600;letter-spacing:.06em;text-transform:uppercase}
.facts strong{display:block;font-family:var(--display);font-size:22px;font-stretch:110%;margin-top:4px}

/* steps */
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:20px;counter-reset:s;list-style:none;margin:0;padding:0}
.steps li{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:32px;position:relative;overflow:hidden}
.steps .n{font-family:var(--display);font-weight:900;font-stretch:125%;font-size:88px;line-height:.8;color:transparent;-webkit-text-stroke:2px var(--ink);display:block;margin-bottom:28px}
.steps li:hover .n{color:var(--accent);-webkit-text-stroke-color:var(--accent)}
.steps .n{transition:color .3s}
.steps p{margin:10px 0 0;color:var(--muted)}

/* reviews */
.revs{display:grid;grid-template-columns:1.4fr 1fr;gap:16px}
@media (max-width:860px){.revs{grid-template-columns:1fr}}
.rev{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:32px;display:flex;flex-direction:column;gap:18px}
.rev.feature{background:var(--ink);color:#fff;border:0;justify-content:space-between}
.rev.feature blockquote{font-family:var(--display);font-weight:800;font-stretch:108%;font-size:clamp(24px,2.8vw,36px);line-height:1.15;letter-spacing:-.015em}
.rev blockquote{margin:0;font-size:17px}
.stars{display:flex;gap:3px;color:var(--accent)}
.who{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:14px;font-weight:600;color:var(--muted)}
.rev.feature .who{color:var(--muted-d)}
.ex{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:4px 10px;border-radius:999px;border:1px solid currentColor;opacity:.8;white-space:nowrap;flex:none}
.revs-side{display:grid;gap:16px}

/* quote form */
.quote{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(28px,5vw,72px);align-items:start}
@media (max-width:900px){.quote{grid-template-columns:1fr}}
.qcard{background:var(--card);border:1px solid var(--line);border-radius:calc(var(--r) + 6px);padding:clamp(22px,3.5vw,40px);box-shadow:0 30px 70px -40px rgba(13,16,21,.35)}
.prog{height:6px;border-radius:999px;background:#ECEAE3;overflow:hidden;margin-bottom:26px}
.prog i{display:block;height:100%;width:33%;background:var(--accent);border-radius:999px;transition:width .4s ease}
.qstep{display:none}.qstep.on{display:block;animation:fadeUp .4s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.qstep legend,.qtitle{font-family:var(--display);font-weight:800;font-size:24px;font-stretch:108%;margin:0 0 18px;padding:0}
fieldset{border:0;margin:0 0 20px;padding:0}
.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(150px,100%),1fr));gap:10px}
.opt{position:relative}
.opt input{position:absolute;opacity:0;inset:0}
.opt label{display:flex;align-items:center;gap:10px;min-height:56px;padding:12px 16px;border-radius:14px;border:1.5px solid var(--line);font-weight:600;cursor:pointer;transition:border-color .2s, background .2s}
.opt label svg{color:var(--muted);flex:none}
.opt input:checked+label{border-color:var(--ink);background:color-mix(in srgb,var(--accent) 14%,#fff)}
.opt input:checked+label svg{color:var(--ink)}
.opt input:focus-visible+label{outline:3px solid var(--accent);outline-offset:2px}
.field{display:flex;flex-direction:column;gap:6px;font-size:14px;font-weight:600;margin-bottom:14px}
.field input,.field textarea{min-height:52px;border:1.5px solid #CFCBC0;border-radius:12px;padding:0 16px;font:inherit;font-weight:400;background:#fff;color:var(--ink)}
.field textarea{padding:14px 16px;min-height:96px;resize:vertical}
.field input:focus,.field textarea:focus{border-color:var(--ink);outline:none;box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 35%,transparent)}
.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(200px,100%),1fr));gap:0 14px}
.qnav{display:flex;justify-content:space-between;gap:12px;margin-top:8px}
.qnav .back{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
.done{text-align:center;padding:24px 0}
.done .tick{width:72px;height:72px;border-radius:50%;background:var(--accent);display:grid;place-items:center;margin:0 auto 18px}
.done p{color:var(--muted)}
.qside{display:flex;flex-direction:column;gap:22px}
.qside .big-phone{font-family:var(--display);font-weight:900;font-stretch:118%;font-size:clamp(30px,3.6vw,46px);text-decoration:none;letter-spacing:-.02em}
.qlist{list-style:none;margin:0;padding:0;display:grid;gap:14px}
.qlist li{display:flex;gap:14px;align-items:center;font-weight:600}
.qlist .i{width:44px;height:44px;border-radius:12px;background:var(--ink);color:var(--accent);display:grid;place-items:center;flex:none}
.qlist small{display:block;color:var(--muted);font-weight:500;font-size:13px}

/* faq */
.faq{max-width:860px}
.faq details{border-bottom:1px solid var(--line)}
.faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:26px 0;font-family:var(--display);font-weight:800;font-size:clamp(19px,2vw,24px);font-stretch:105%}
.faq summary::-webkit-details-marker{display:none}
.faq .pm{width:40px;height:40px;border-radius:50%;border:1.5px solid var(--ink);display:grid;place-items:center;flex:none;transition:transform .3s, background .3s}
.faq details[open] .pm{transform:rotate(45deg);background:var(--accent);border-color:var(--accent)}
.faq details p{margin:0 0 26px;color:var(--muted);max-width:44em;font-size:17px}

/* cta */
.cta{background:var(--accent);color:var(--on-accent);border-radius:calc(var(--r) + 10px);padding:clamp(36px,6vw,80px);display:flex;flex-wrap:wrap;gap:32px;align-items:flex-end;justify-content:space-between;position:relative;overflow:hidden}
.cta h2{max-width:12ch}
.cta .bolt{position:absolute;right:-40px;top:-40px;opacity:.12;width:320px;height:320px}
.areas{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px;padding:0;list-style:none}
.areas li{padding:8px 14px;border-radius:999px;border:1.5px solid rgba(13,16,21,.35);font-weight:600;font-size:14px}

/* footer */
footer{background:var(--ink);color:var(--muted-d);font-size:14px;padding:36px 0 120px}
footer .wrap{display:flex;flex-wrap:wrap;gap:12px 28px;justify-content:space-between}
footer a{color:#fff}
@media (min-width:761px){footer{padding-bottom:36px}}

/* mobile bar */
.mbar{position:fixed;left:12px;right:12px;bottom:12px;z-index:70;display:none;gap:10px;padding:10px;border-radius:20px;background:rgba(13,16,21,.92);backdrop-filter:blur(12px);box-shadow:0 20px 40px rgba(0,0,0,.35)}
.mbar .btn{flex:1;min-height:50px;padding:0 12px}
@media (max-width:760px){.mbar{display:flex}}

/* reveal */
.rv{opacity:0;transform:translateY(28px);transition:opacity .8s ease, transform .8s cubic-bezier(.2,.7,.2,1)}
.rv.in{opacity:1;transform:none}
.rv.d1{transition-delay:.08s}.rv.d2{transition-delay:.16s}.rv.d3{transition-delay:.24s}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
  .rv{opacity:1;transform:none}
  .spark::after{transform:scaleX(1)}
  .hero-img{transform:none}
}
